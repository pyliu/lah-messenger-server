# WebSocket server settings
WEBSOCKET_HOST=XXX.XXX.XXX.XXX
WEBSOCKET_PORT=8081
HTTP_PORT=8082

# 允許「未註冊 (沒有 userid/username)」的連線接收推播並維持連線，僅供本機測試/監看用
# 正式環境請保持 false 或不設定
WS_ALLOW_ANONYMOUS=false

# 附件上傳 API 設定 (皆為選填)
# 檔案大小上限 (位元組)，預設 10485760 (10 MB)
FILE_UPLOAD_MAX_SIZE=10485760
# 允許的 MIME 類型 (逗號分隔)，未設定則使用內建預設 (PDF/Office全系列/ODF全系列/RTF/純文字/公文/CAD圖資/TIFF掃描/圖檔/郵件/ZIP/7Z/RAR等)
# FILE_UPLOAD_ALLOWED_MIMES=application/pdf,application/zip,application/x-zip-compressed
# 允許的副檔名清單 (逗號分隔，不含小數點)，未設定則使用內建預設 (pdf,docx,odt,dwg,tif,rar,txt等)
# FILE_UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx,odt,ods,odp,odg,rtf,txt,csv,dwg,dxf,tif,tiff,rar,zip,7z
# 簡易 Token 認證，設定後呼叫 API 需帶 Header: X-Auth-Token
# UPLOAD_AUTH_TOKEN=your-secret-token
