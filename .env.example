# WebSocket server settings
WEBSOCKET_HOST=XXX.XXX.XXX.XXX
WEBSOCKET_PORT=8081
HTTP_PORT=8082

# 允許「未註冊 (沒有 userid/username)」的連線接收推播並維持連線，僅供本機測試/監看用
# 正式環境請保持 false 或不設定
WS_ALLOW_ANONYMOUS=false

# 附件上傳 API 設定 (皆為選填)
# 檔案大小上限 (位元組)，預設 10485760 (10 MB)
FILE_UPLOAD_MAX_SIZE=10485760
# 允許的 MIME 類型 (逗號分隔)，未設定則使用內建預設 (PDF/DOCX/XLSX/PPTX/ZIP/7Z)
# FILE_UPLOAD_ALLOWED_MIMES=application/pdf,application/zip
# 簡易 Token 認證，設定後呼叫 API 需帶 Header: X-Auth-Token
# UPLOAD_AUTH_TOKEN=your-secret-token
